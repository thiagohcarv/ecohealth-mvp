# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results/
/playwright-report/

# next.js
.next/
/out/

# production
/build
dist/

# secrets / certificates
*.pem
*.pfx
*.key

# temp
/tmp/

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (all variants, any environment)
.env
.env*.local
.env.production
.env.development

# local Claude Code settings (per-developer, not shared)
.claude/settings.local.json

# project snapshots — may bundle env files, never for the repo
outputs/*.zip

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*
