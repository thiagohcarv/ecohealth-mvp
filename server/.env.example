# ─── Banco de Dados ───────────────────────────────────────────────────────────
# Local (Docker):  postgresql://postgres:postgres@localhost:5433/ecohealth_dev
# Supabase:        postgresql://postgres.[ref]:[senha]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecohealth_dev

# ─── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Autenticação ─────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-string-aleatoria-minimo-32-chars-use-openssl

# ─── Criptografia de campos médicos (AES-256-GCM) ────────────────────────────
# Gere com: openssl rand -hex 32  (NUNCA compartilhe ou comite este valor)
# Obrigatório: o servidor não inicia sem ele (proteção de dados LGPD/CFM)
ENCRYPTION_KEY=troque-por-string-aleatoria-minimo-32-chars-use-openssl

# ─── OpenAI (Whisper + GPT-4o) ────────────────────────────────────────────────
# Sem créditos: mocks automáticos são usados (zero mudança de código)
# Com créditos:  sk-proj-...
OPENAI_API_KEY=

# ─── AWS S3 (armazenamento de áudio criptografado) ───────────────────────────
# Opcional em dev: sem estas variáveis, o áudio é salvo localmente em /tmp/ecohealth/audio
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ecohealth-audio-dev

# ─── Anthropic / Claude (Sprint 2 — fallback IA) ─────────────────────────────
ANTHROPIC_API_KEY=

# ─── App URL (CORS) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Load testing (k6) ─────────────────────────────────────────────────────────
# Eleva os rate limits por IP (geral, auth, IA, áudio) para permitir testes de
# carga de uma única máquina. NUNCA definir como "true" em produção.
LOAD_TEST_MODE=false
