# ═══════════════════════════════════════════════════════════════════════════
# EcoHealth API — Variáveis de Ambiente de Produção (Render)
# ═══════════════════════════════════════════════════════════════════════════
# Copie os valores para o painel do Render em:
#   Dashboard → seu serviço → Environment
#
# Este arquivo é apenas referência — NUNCA commite um .env real preenchido.
# ═══════════════════════════════════════════════════════════════════════════

# ─── OBRIGATÓRIAS ───────────────────────────────────────────────────────────
# O servidor recusa iniciar (exit code 1) se alguma destas faltar ou for
# menor que o mínimo exigido — ver server/src/lib/checkEnv.ts

# String de conexão PostgreSQL de produção.
# Render Postgres: painel do banco → "Internal Database URL" (mesma região = mais rápido)
# Externo (Supabase, Neon, RDS): postgresql://user:senha@host:porta/db?sslmode=require
DATABASE_URL=

# Segredo para assinatura de JWT — mínimo 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=

# Chave AES-256-GCM para criptografia de campos médicos (LGPD/CFM) — mínimo 32 caracteres.
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=

# Ambiente de execução
NODE_ENV=production

# Porta que o servidor escuta — 10000 é o padrão do Render
PORT=10000

# Origens autorizadas por CORS — URL(s) do frontend no Vercel, separadas por vírgula
# Ex: https://ecohealth.vercel.app,https://app.ecohealth.com.br
ALLOWED_ORIGINS=

# ─── OPCIONAIS ──────────────────────────────────────────────────────────────

# Chave OpenAI (Whisper + GPT-4o). Sem ela, transcrição/SOAP usam dados mockados.
OPENAI_API_KEY=

# Fallback Claude 3.5 Sonnet (Sprint 2)
ANTHROPIC_API_KEY=

# AWS S3 — armazenamento de áudio criptografado. Sem estas 4 variáveis, o áudio
# cai no fallback local em /tmp/ecohealth/audio — NÃO recomendado em produção,
# pois é efêmero e perdido a cada deploy/restart do serviço no Render.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# URL pública do frontend — usada apenas como fallback de CORS se ALLOWED_ORIGINS
# não estiver definida. Prefira configurar ALLOWED_ORIGINS explicitamente.
NEXT_PUBLIC_APP_URL=

# Mantenha "false" em produção — "true" eleva os rate limits para testes de
# carga (k6) e não deve ser usado com tráfego real.
LOAD_TEST_MODE=false

# Credenciais opcionais para o script de seed (server/prisma/seed.ts).
# Se omitidas, usa valores padrão de demonstração — ver seed.ts.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
